{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/common/SideBar.vue?vue&type=script&lang=js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/common/SideBar.vue","mtime":1793111884142},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/thread-loader/dist/cjs.js","mtime":1793113946318},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["SideBar.vue"],"names":[],"mappings":";AAoEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"SideBar.vue","sourceRoot":"src/components/common","sourcesContent":["<template>\n  <div class=\"nav\">\n    <div\n      v-if=\"homePage\"\n      :style=\"{ background: '#747378 url(icon-login.png) no-repeat 50% 21px' }\"\n      class=\"login\"\n      style=\"cursor:not-allowed;\"\n    >\n      로그인\n    </div>\n\n    <div v-else>\n      <div class=\"myinfo\"  style=\"cursor:grab;\">\n        <span class=\"name-kor\">KYUNG HEE</span>\n        <span class=\"name-eng\">2020109999</span>\n      </div>\n    </div>\n    <div class=\"wrap-menu\">\n      <ul>\n        <li\n          @click=\"toNotice\" \n          v-bind:class=\"{ 'selected-menu': menu.isNotice && !homePage }\"\n          class=\"notice\"\n        >\n          <img src=\"icon-notice.png\" />\n          <span class=\"menu-kor\">공지사항</span>\n        </li>\n        <li style=\"cursor:not-allowed;\"\n        >\n          <img src=\"icon-planning.png\" />\n          <span class=\"menu-kor\">종합시간표 조회</span>\n        </li>\n        <li\n          @click=\"toWishList\"\n          v-bind:class=\"{ 'selected-menu': menu.isWishList }\"\n        >\n          <img src=\"icon-subject.png\" />\n          <span class=\"menu-kor\">희망과목내역</span>\n        </li>\n        <li\n          @click=\"toCourseList\"\n          v-bind:class=\"{ 'selected-menu': menu.isCourseList }\"\n        >\n          <img src=\"icon-search.png\" />\n          <span class=\"menu-kor\">수강신청내역</span>\n        </li>\n        <li\n          @click=\"toRegister\"\n          class=\"m-el registration\"\n          v-bind:class=\"{ 'selected-menu': menu.isRegister }\"\n        >\n          <img src=\"icon-registration.png\" />\n          <span class=\"menu-kor\">수강신청</span>\n        </li>\n        <li\n          @click=\"toExchange\"\n          class=\"m-el exchange\"\n          v-bind:class=\"{ 'selected-menu': menu.isExchange }\"\n        >\n          <span class=\"exchange-icon\" aria-hidden=\"true\">⇄</span>\n          <span class=\"menu-kor\">수강신청<br />맞교환</span>\n        </li>\n      </ul>\n    </div>\n  </div>\n</template> \n\n<script>\nexport default {\n  props: [\"homePage\"],\n  data() {\n    return {\n      menu: {\n        isCourseList: false,\n        isRegister: false,\n        isNotice: true,\n        isWishList: false,\n        isExchange: false,\n      },\n    };\n  },\n  methods: {\n    // 공지사항탭\n    toNotice() {\n       if (this.homePage) {\n        alert(\"로그인이 필요한 서비스입니다.\\n 로그인 화면으로 이동합니다.\");\n        location.reload();\n        return;\n      }\n      // 로그인하지 않은 상황\n      for (let menu in this.menu) {\n        menu === \"isNotice\"\n          ? (this.menu[menu] = true)\n          : (this.menu[menu] = false);\n      }\n      this.$emit(\"changeMenu\", \"noticeMenu\");\n    },\n    //희망과목탭\n    toWishList() {\n      if (this.homePage) {\n        alert(\"로그인이 필요한 서비스입니다.\\n 로그인 화면으로 이동합니다.\");\n        location.reload();\n        return;\n      }\n      for (let menu in this.menu) {\n        menu === \"isWishList\"\n          ? (this.menu[menu] = true)\n          : (this.menu[menu] = false);\n      }\n      this.$emit(\"changeMenu\", \"wishMenu\");\n    },\n    //신청내역탭\n    toCourseList() {\n      if (this.homePage) {\n        alert(\"로그인이 필요한 서비스입니다.\\n 로그인 화면으로 이동합니다.\");\n        location.reload();\n        return;\n      }\n      for (let menu in this.menu) {\n        menu === \"isCourseList\"\n          ? (this.menu[menu] = true)\n          : (this.menu[menu] = false);\n      }\n      this.$emit(\"changeMenu\", \"listMenu\");\n    },\n    //수강신청탭\n    toRegister() {\n      if (this.homePage) {\n        alert(\"로그인이 필요한 서비스입니다.\\n 로그인 화면으로 이동합니다.\");\n        location.reload();\n        return;\n      }\n      for (let menu in this.menu) {\n        menu === \"isRegister\"\n          ? (this.menu[menu] = true)\n          : (this.menu[menu] = false);\n      }\n      this.$emit(\"changeMenu\", \"registerMenu\");\n    },\n    // 수강신청 맞교환 탭\n    toExchange() {\n      if (this.homePage) {\n        alert(\"로그인이 필요한 서비스입니다.\\n 로그인 화면으로 이동합니다.\");\n        location.reload();\n        return;\n      }\n      for (let menu in this.menu) {\n        this.menu[menu] = menu === \"isExchange\";\n      }\n      this.$emit(\"changeMenu\", \"exchangeMenu\");\n    },\n  },\n};\n</script>\n\n<style>\n.nav {\n  position: fixed;\n  top: 0;\n  left: 0;\n  bottom: 0;\n  z-index: 5;\n  width: 120px;\n  background: #253a73;\n  transition: all 0.4s;\n}\n.nav .myinfo {\n    position: relative;\n    width: 100%;\n    height: 60px;\n    padding-top: 9px;\n    background: #717075;\n    text-align: center;\n    box-sizing: border-box;\n    cursor: pointer;\n}\n.nav .myinfo .name-kor {\n    font-size: 16px;\n    color: #fff;\n}\n.nav .myinfo .name-eng {\n    position: relative;\n    top: -2px;\n    font-size: 12px;\n    color: #fff;\n}\n.login {\n  display: block;\n}\n.nav .login {\n  position: relative;\n  width: 100%;\n  height: 94px;\n  padding-top: 56px;\n  /* background: #747378 url(./img/icon-login.png) no-repeat 50% 21px; */\n  font-size: 16px;\n  font-weight: bold;\n  color: #fff;\n  text-align: center;\n  box-sizing: border-box;\n}\n.nav.login .wrap-menu {\n  height: calc(100% - 184px);\n}\n.nav .wrap-menu > ul {\n  position: absolute;\n  width: 100%;\n}\n.nav .wrap-menu > ul > li {\n  cursor: pointer;\n  position: relative;\n  width: 100%;\n  padding: 20px 0;\n  text-align: center;\n}\n.nav .wrap-menu > ul > li img {\n  margin-bottom: 5px;\n}\n.nav .wrap-menu > ul > li .exchange-icon {\n  display: block;\n  margin: 0 auto 5px;\n  color: #fff;\n  font-size: 25px;\n  line-height: 24px;\n  font-weight: bold;\n}\n.nav .wrap-menu > ul > li [class^=\"menu\"] {\n  font-size: 12px;\n  width: 100%;\n  color: #fff;\n  line-height: 1.4;\n}\n/* 푸터 */\n.container .footer {\n  width: 100%;\n  height: 35px;\n  line-height: 35px;\n  background: #f0f0f0;\n  font-size: 11px;\n  color: #999;\n  text-align: center;\n}\n.selected-menu {\n  background-color: #b6985a;\n}\n</style>"]}]}