{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/menu/ExchangeMenu.vue?vue&type=style&index=0&id=5c031c25&prod&scoped=true&lang=css","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/menu/ExchangeMenu.vue","mtime":1793111884964},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/css-loader/dist/cjs.js","mtime":1793113953976},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1793113951739},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/postcss-loader/src/index.js","mtime":1793113949945},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ExchangeMenu.vue"],"names":[],"mappings":";AAoHA;AACA;AACA","file":"ExchangeMenu.vue","sourceRoot":"src/components/menu","sourcesContent":["<template>\n  <div class=\"exchange-app\">\n    <div class=\"demo-banner\">모의 서비스이며 실제 수강신청과 무관합니다 · 가상 대학교 데이터</div>\n    <header class=\"exchange-header\">\n      <strong class=\"brand\">수강신청 맞교환</strong>\n      <nav><button v-for=\"tab in tabs\" :key=\"tab.id\" :class=\"{active: page===tab.id}\" @click=\"page=tab.id\">{{ tab.label }}</button></nav>\n      <div class=\"user-pill\">익명 다람쥐 #4821</div>\n    </header>\n\n    <main v-if=\"page==='search'\" class=\"page-wrap\">\n      <div class=\"page-title-row\"><div><h1>강의 검색</h1><p>2026학년도 2학기 · 관심 있는 강의를 자유롭게 찜해 두세요. 찜은 매칭에 참여하지 않아요.</p></div><button class=\"dark-button\" @click=\"page='mine'\">찜 {{ wishIds.length }}개 · 내 페이지에서 교환 쌍 정하기</button></div>\n      <section class=\"panel search-panel\">\n        <div class=\"filters\">\n          <label>학과<select v-model=\"filters.department\"><option>전체</option><option>컴퓨터공학과</option><option>교양</option><option>경영학과</option></select></label>\n          <label>학년<select v-model=\"filters.year\"><option>전체</option><option>1학년</option><option>2학년</option><option>3학년</option><option>4학년</option></select></label>\n          <label>이수구분<select v-model=\"filters.type\"><option>전체</option><option>전공필수</option><option>전공선택</option><option>교양필수</option><option>교양</option></select></label>\n          <label>교수<select v-model=\"filters.professor\"><option>전체</option><option>김OO</option><option>정OO</option><option>박OO</option><option>윤OO</option><option>한OO</option></select></label>\n          <label>요일<select v-model=\"filters.day\"><option>전체</option><option>월</option><option>화</option><option>수</option><option>목</option><option>금</option></select></label>\n          <label>시간대<select v-model=\"filters.time\"><option>전체</option><option>오전</option><option>오후</option></select></label>\n        </div>\n        <label class=\"keyword-label\">강의명 · 학수번호<div class=\"keyword-row\"><input v-model=\"keyword\" @keyup.enter=\"searchCourses\" placeholder=\"예: 컴파일러, CSE322\"/><button class=\"primary-button\" @click=\"searchCourses\">검색</button></div></label>\n      </section>\n      <section class=\"panel results-panel\">\n        <div class=\"panel-head\"><strong>검색 결과 {{ filteredCourses.length }}건</strong><span>희망자 = 이 강의를 받으려고 대기 중 · 보유자 = 이 강의를 내놓고 대기 중</span></div>\n        <div class=\"table-scroll\"><table><thead><tr><th>학수번호</th><th>과목명</th><th>분반</th><th>교수</th><th>시간</th><th>학점</th><th>이수구분</th><th>희망자</th><th>보유자</th><th>찜</th></tr></thead><tbody>\n          <tr v-for=\"course in filteredCourses\" :key=\"course.code\"><td>{{ course.code }}</td><td><button class=\"course-link\" @click=\"openCourse(course)\">{{ course.name }}</button><span v-if=\"isMine(course.code)\" class=\"my-badge\">내 강의</span></td><td>{{ course.section }}</td><td>{{ course.professor }}</td><td>{{ course.time }}</td><td>{{ course.credits }}</td><td>{{ course.type }}</td><td class=\"number-cell\">{{ course.wishers }}명</td><td class=\"number-cell\">{{ course.holders }}명</td><td><button :class=\"['wish-button',{wished:wishIds.indexOf(course.code)!==-1}]\" @click=\"toggleWish(course)\">{{ wishIds.indexOf(course.code)!==-1?'★ 찜함':'☆ 찜' }}</button></td></tr>\n          <tr v-if=\"!filteredCourses.length\"><td colspan=\"10\" class=\"empty\">검색 결과가 없습니다.</td></tr>\n        </tbody></table></div>\n      </section><p class=\"footnote\">찜은 학점 상한·시간표와 상관없이 마음껏 할 수 있어요. 조건 검사는 내 페이지에서 교환 쌍을 고를 때마다 보여 줘요.</p>\n    </main>\n\n    <main v-else-if=\"page==='detail' && selectedCourse\" class=\"page-wrap\">\n      <div class=\"breadcrumb\"><button @click=\"page='search'\">강의 검색</button> › {{ selectedCourse.name }} {{ selectedCourse.section }}분반</div>\n      <section class=\"panel detail-hero\"><div><h1>{{ selectedCourse.name }} <span class=\"chip\">{{ selectedCourse.section }}분반</span><span class=\"chip\">{{ selectedCourse.type }}</span></h1><div class=\"detail-meta\">{{ selectedCourse.code }}　 {{ selectedCourse.professor }} 교수　 {{ selectedCourse.time }}　 {{ selectedCourse.credits }}학점　 정원 {{ selectedCourse.capacity }}명</div><button :class=\"['wish-button big-wish',{wished:wishIds.indexOf(selectedCourse.code)!==-1}]\" @click=\"toggleWish(selectedCourse)\">{{ wishIds.indexOf(selectedCourse.code)!==-1?'★ 찜함':'★ 찜하기' }}</button></div><div class=\"totals\"><div><span>희망자 합계</span><strong>{{ selectedCourse.wishers }}명</strong></div><div><span>보유자 합계</span><strong>{{ selectedCourse.holders }}명</strong></div></div></section>\n      <section class=\"panel\"><div class=\"panel-head detail-head\"><div><h2>교환 쌍별 대기 현황</h2><p>{{ selectedCourse.name }}을(를) 기준으로 어떤 과목과 바꾸려는지에 따라 대기열이 따로 있어요</p></div><label class=\"check-label\"><input type=\"checkbox\" v-model=\"onlyPossible\"/> 내 강의와 바꿀 수 있는 쌍만 ({{ possiblePairs.length }} / {{ pairRows.length }})</label></div>\n        <div class=\"table-scroll\"><table class=\"pair-table\"><thead><tr><th>상대가 원하는 강의<br/><small>(이 강의를 보유자가 받고 싶은 강의)</small></th><th>같은 강의를 보유한 경쟁자</th><th>{{ selectedCourse.name }}을 내놓은 사람</th><th>내 순위</th><th>상태</th></tr></thead><tbody><tr v-for=\"pair in shownPairs\" :key=\"pair.wants\"><td><b>{{ pair.wants }}</b><span v-if=\"isMine(pair.code)\" class=\"my-badge\">내 강의</span></td><td>{{ pair.competitors }}명</td><td>{{ pair.holders }}명</td><td>{{ pair.rank }}</td><td :class=\"pair.possible?'good-text':'muted-text'\">{{ pair.status }}</td></tr></tbody></table></div>\n        <div class=\"panel-foot\"><span>양쪽에 모두 사람이 있으면 각 대기열 1위끼리 매칭돼요. 순위는 우선순위 점수 순이에요.</span><button class=\"dark-button\" @click=\"page='mine'\">내 페이지에서 교환 쌍 정하기</button></div>\n      </section><section class=\"panel score-note\"><strong>우선순위 점수</strong><p>학년, 교환 취소 이력, 기다린 시간, 포인트, 패널티, 그리고 내가 이 강의에 매긴 희망 순위로 계산해요. 가중치는 정하는 중이에요.</p><p>다른 사람의 닉네임과 점수는 보이지 않고, 인원수와 내 순위만 보여요.</p></section>\n    </main>\n\n    <main v-else-if=\"page==='mine'\" class=\"page-wrap\">\n      <div class=\"page-title-row\"><div><h1>내 페이지</h1><p>다른 사람에게는 랜덤 닉네임만 보여요.</p></div><div class=\"stat-row\"><div class=\"stat\"><span>포인트</span><strong>120</strong></div><div class=\"stat\"><span>패널티</span><strong>0</strong></div><div class=\"stat\"><span>교환 완료</span><strong>{{ history.length }}건</strong></div></div></div>\n      <section class=\"panel matrix-panel\"><div class=\"panel-head\"><div><h2>찜 목록 · 교환 쌍 정하기</h2><p>찜한 강의(희망)와 내가 듣는 강의(열)는 칸이 교환 쌍이에요. 칸마다 조건을 확인해 뒀어요.</p></div><button class=\"text-button\" @click=\"page='search'\">강의 더 하기 ›</button></div>\n        <div class=\"legend\"><span><i class=\"blue-dot\"></i> 선택한 쌍</span><span><i class=\"gray-dot\"></i> 가능 · 선택 안 함</span><span><i class=\"light-dot\"></i> 불가 · 사유 표시</span></div>\n        <div class=\"table-scroll\"><table class=\"matrix\"><thead><tr><th>찜한 강의 · 희망 순위<br/>받고 싶은 강의</th><th v-for=\"owned in ownedCourses\" :key=\"owned.code\">내놓을 강의<br/><b>{{ owned.name }} {{ owned.section }}</b><small>{{ owned.time }}</small></th></tr></thead><tbody><tr v-for=\"(wanted, wi) in wishedCourses\" :key=\"wanted.code\"><td><span class=\"rank\">{{ wi+1 }}순위</span><b>{{ wanted.name }} {{ wanted.section }}</b><small>{{ wanted.time }} · {{ wanted.credits }}학점</small><div class=\"rank-buttons\"><button @click=\"moveWish(wi,-1)\" :disabled=\"wi===0\">↑</button><button @click=\"moveWish(wi,1)\" :disabled=\"wi===wishedCourses.length-1\">↓</button></div></td><td v-for=\"owned in ownedCourses\" :key=\"owned.code\" :class=\"['matrix-cell',pairAllowed(wanted,owned)?(isPairSelected(wanted,owned)?'selected':'available'):'unavailable']\"><button v-if=\"pairAllowed(wanted,owned)\" @click=\"togglePair(wanted,owned)\"><span>{{ isPairSelected(wanted,owned)?'☑':'□' }}　{{ isPairSelected(wanted,owned)?'선택함':'가능' }}</span></button><span v-else><b>불가</b><small>{{ wanted.time===owned.time?'같은 시간대 겹침':'시연용 조건 불일치' }}</small></span></td></tr></tbody></table></div>\n        <div class=\"selected-summary\"><div><strong>선택한 교환 쌍 {{ selectedPairs.length }}개</strong><div class=\"pair-chips\"><span v-for=\"pair in selectedPairs\" :key=\"pair.key\">{{ pair.ownedName }} → {{ pair.wantedName }}</span><span v-if=\"!selectedPairs.length\">선택한 교환 쌍이 없습니다</span></div></div><button class=\"primary-button\" @click=\"startMatching\" :disabled=\"!selectedPairs.length\">매칭 시작 · {{ selectedPairs.length }}쌍</button></div><p class=\"footnote\">버튼을 누르면 선택한 쌍들이 각자의 대기열에 들어가요. 하나가 교환되면 같은 강의를 내놓은 쌍과 받는 쌍은 자동으로 지워지는 시연 흐름이에요.</p>\n      </section>\n      <section class=\"panel\"><div class=\"panel-head\"><h2>내 교환 쌍 · 대기 현황</h2><span>매칭 시작 후 내가 들어가 있는 대기열만 보여요</span></div><div class=\"filter-row\"><label>내놓는 강의<select v-model=\"ownedFilter\"><option>전체</option><option v-for=\"c in ownedCourses\" :key=\"c.code\">{{ c.name }}</option></select></label><label>상태<select v-model=\"statusFilter\"><option>전체</option><option>대기</option><option>매칭 중</option><option>잠김</option><option>교환 완료</option></select></label></div><div class=\"table-scroll\"><table><thead><tr><th>내놓는 강의 → 받을 강의</th><th>희망 순위</th><th>내 순위</th><th>반대쪽 대기</th><th>상태</th><th></th></tr></thead><tbody><tr v-for=\"pair in filteredMyPairs\" :key=\"pair.key\"><td><b>{{ pair.ownedName }} → {{ pair.wantedName }}</b></td><td>{{ pair.priority }}순위</td><td>{{ pair.rank }}</td><td>{{ pair.opposite }}</td><td><span :class=\"['status-pill',statusClass(pair.status)]\">{{ pair.status }}</span><small class=\"substatus\">{{ pair.note }}</small></td><td><button v-if=\"pair.status!=='교환 완료'\" class=\"small-button\" @click=\"openSession(pair)\">세션 열기</button><span v-else>완료</span></td></tr><tr v-if=\"!filteredMyPairs.length\"><td colspan=\"6\" class=\"empty\">표시할 교환 쌍이 없습니다. 위에서 강의를 선택하고 매칭을 시작해 보세요.</td></tr></tbody></table></div></section>\n      <section class=\"panel\"><div class=\"panel-head\"><h2>교환 기록</h2></div><table><thead><tr><th>일시</th><th>준 강의 → 받은 강의</th><th>결과</th><th>변화</th></tr></thead><tbody><tr v-for=\"(item,i) in history\" :key=\"i\"><td>{{ item.date }}</td><td>{{ item.from }} → {{ item.to }}</td><td class=\"good-text\">교환 완료</td><td>-</td></tr><tr v-if=\"!history.length\"><td colspan=\"4\" class=\"empty\">아직 교환 기록이 없습니다.</td></tr></tbody></table></section>\n      <section class=\"panel upload-panel\"><div class=\"panel-head\"><div><h2>수강신청 내역</h2><p>현재 수강 중인 강의예요. 교환이 완료되면 준 강의는 빠지고 받은 강의가 반영돼요.</p></div></div><div class=\"uploaded-list\"><div v-for=\"course in enrolledCourses\" :key=\"course.code\"><span><b>{{ course && course.code ? course.code + ' · ' + course.name + ' ' + course.section + '분반' : 'ADD123-01 · 삭제연습' + course }}</b><small>{{ course && course.code ? course.professor + ' · ' + course.time + ' · ' + course.credits + '학점' : '기존 시연 데이터' }}</small></span></div><p v-if=\"!enrolledCourses.length\" class=\"empty\">수강신청 내역이 없습니다.</p></div></section>\n    </main>\n\n    <main v-else class=\"page-wrap session-wrap\">\n      <div class=\"session-title\"><p>교환 세션 #1042 · 대화 기능은 없어요</p><h1>익명 해달 #5530 님과 매칭됐어요</h1></div>\n      <div class=\"steps\"><div :class=\"{done:sessionStep>=1,active:sessionStep===1}\">1 조건 재검사 통과</div><div :class=\"{done:sessionStep>=2,active:sessionStep===2}\">2 최종 확정</div><div :class=\"{done:sessionStep>=3,active:sessionStep===3}\">3 교환 완료</div></div>\n      <section class=\"panel swap-card\"><div class=\"swap-side\"><span>내가 줄 강의</span><h2>{{ activePair ? activePair.ownedName : '프로그래밍언어론 01분반' }}</h2><p>화목 15:00–16:15 · 3학점 · 전공선택</p></div><div class=\"swap-arrow\">⇄</div><div class=\"swap-side received\"><span>내가 받을 강의 · 희망 1순위</span><h2>{{ activePair ? activePair.wantedName : '대학영어 03분반' }}</h2><p>화목 15:00–16:15 · 2학점 · 교양필수</p></div><p class=\"verification\" v-if=\"sessionStep>=1\">✓　매칭 순간 서버가 시간표 겹침과 학점 상한을 다시 확인했어요</p></section>\n      <section class=\"panel confirm-card\"><template v-if=\"sessionStep===1\"><h2>조건 재검사 통과</h2><p>시간표와 교환 조건을 다시 확인했어요. 다음 단계에서 양쪽이 교환을 최종 확정해야 해요.</p><div class=\"confirm-actions\"><button class=\"primary-button\" @click=\"sessionStep=2;startCountdown()\">최종 확정 단계로</button><button class=\"outline-button danger\" @click=\"rejectSession\">교환 거절</button></div></template><template v-else-if=\"sessionStep===2\"><p class=\"orange-text\">자동 취소까지 남은 시간</p><div class=\"countdown\">{{ countdownDisplay }}</div><div class=\"confirm-status\"><div class=\"accepted\"><span>나</span><strong>확정함 · 14:31</strong></div><div :class=\"otherAccepted?'accepted':'waiting'\"><span>익명 해달 #5530 (상대 보유자)</span><strong>{{ otherAccepted?'확정함 · 14:32':'아직 확정 안 함' }}</strong></div></div><div class=\"confirm-actions\"><button class=\"primary-button\" @click=\"completeExchange\">{{ otherAccepted?'최종 교환 확정 완료':'최종 교환 확정 (시연)' }}</button><button class=\"outline-button\" @click=\"otherAccepted=!otherAccepted\">상대 {{ otherAccepted?'확정 취소':'깨우기 (알림)' }}</button><button class=\"outline-button danger\" @click=\"rejectSession\">교환 거절</button></div><p class=\"helper-text\">시연용: 상대가 확정하지 않은 상태에서도 최종 확정을 누르면 완료 화면으로 이동합니다.</p></template><template v-else-if=\"sessionStep===3\"><div class=\"completed-mark\">✓</div><h2>교환이 완료되었어요!</h2><p>완료 일시: {{ completedAt || '2026-10-23 14:32' }}</p><p>수강신청내역 탭에 교환 결과를 반영했어요. (시연 데이터)</p><button class=\"primary-button\" @click=\"page='mine'\">내 페이지로 돌아가기</button></template><template v-else><h2>교환 세션 종료</h2><p>교환이 거절되었거나 제한 시간 5분이 지나 자동 취소되었어요. 내 페이지에서 다른 교환 쌍을 선택할 수 있어요.</p><button class=\"primary-button\" @click=\"page='mine'\">내 페이지로</button></template></section>\n      <section class=\"panel score-note\"><strong>단계 안내</strong><p>1단계는 시간표·학점·희망 조건을 다시 검증하는 단계예요. 2단계는 요청자와 상대 보유자가 각각 최종 확정하는 단계이며, 3단계는 교환 완료 일시를 안내하고 수강신청내역에 반영해요.</p></section>\n    </main>\n    <footer class=\"exchange-footer\">경희대학교 수강신청 맞교환 · 시연용 화면</footer>\n  </div>\n</template>\n\n<script>\n// 데모 데이터입니다. 실제 API가 준비되면 아래 mock 데이터를 GET /api/courses 응답으로 교체하세요.\n// 예시(실연동 시): axios.get('/api/courses', { params: searchFilters }).then(({ data }) => { this.courses = data; });\n// 상세 대기현황은 GET /api/courses/:courseId/exchange-queues, 내 강의는 GET/POST /api/my-courses로 연결할 수 있습니다.\nconst demoCourses = [\n  {code:'CSE322',name:'컴파일러',section:'01',professor:'김OO',time:'월수 12:00-13:15',credits:3,type:'전공필수',capacity:40,wishers:4,holders:1,department:'컴퓨터공학과',year:'3학년'},\n  {code:'CSE210',name:'프로그래밍언어론',section:'01',professor:'정OO',time:'화목 15:00-16:15',credits:3,type:'전공선택',capacity:40,wishers:2,holders:1,department:'컴퓨터공학과',year:'2학년'},\n  {code:'GEN101',name:'대학영어',section:'03',professor:'박OO',time:'화목 15:00-16:15',credits:2,type:'교양필수',capacity:40,wishers:6,holders:3,department:'교양',year:'1학년'},\n  {code:'CSE330',name:'데이터베이스',section:'01',professor:'윤OO',time:'화목 09:00-10:15',credits:3,type:'전공선택',capacity:40,wishers:5,holders:2,department:'컴퓨터공학과',year:'3학년'},\n  {code:'CSE340',name:'운영체제',section:'02',professor:'한OO',time:'월수 13:30-14:45',credits:3,type:'전공기초',capacity:40,wishers:15,holders:1,department:'컴퓨터공학과',year:'3학년'},\n  {code:'CSE201',name:'자료구조',section:'01',professor:'오OO',time:'월수 15:00-16:15',credits:3,type:'전공기초',capacity:40,wishers:8,holders:4,department:'컴퓨터공학과',year:'2학년'},\n  {code:'BUS110',name:'경영학원론',section:'02',professor:'서OO',time:'금 10:00-12:45',credits:3,type:'교양',capacity:40,wishers:3,holders:2,department:'경영학과',year:'1학년'}\n];\nexport default {\n  props: ['courseList'],\n  data() { return {\n    page:'search', tabs:[{id:'search',label:'강의 검색'},{id:'mine',label:'내 페이지'},{id:'session',label:'매칭 세션'}], courses:demoCourses, selectedCourse:null, keyword:'', appliedKeyword:'', wishIds:['GEN101','CSE330','CSE340','CSE201'], filters:{department:'전체',year:'전체',type:'전체',professor:'전체',day:'전체',time:'전체'}, onlyPossible:true,\n    pairRows:[{wants:'프로그래밍언어론 01',code:'CSE210',competitors:2,holders:1,rank:'1위 / 2명',status:'매칭 중',possible:true},{wants:'컴파일러 01',code:'CSE322',competitors:1,holders:0,rank:'없음 · 시간 겹침',status:'반대쪽 없음',possible:false}],\n    ownedCourses:[{code:'CSE210',name:'프로그래밍언어론',section:'01',time:'화목 15:00–16:15',credits:3},{code:'CSE322',name:'컴파일러',section:'01',time:'월수 12:00–13:15',credits:3},{code:'CSE330',name:'데이터베이스',section:'01',time:'화목 09:00–10:15',credits:3},{code:'CSE340',name:'운영체제',section:'02',time:'월수 13:30–14:45',credits:3}], selectedPairs:[], myPairs:[], ownedFilter:'전체',statusFilter:'전체',showUpload:false,upload:{code:'',name:'',section:'01',professor:'',time:'',credits:3},uploadedCourses:[],sessionStep:1,activePair:null,otherAccepted:false,completedAt:'',history:[],countdownSeconds:300,countdownTimer:null\n  }; },\n  computed:{\n    enrolledCourses(){return this.courseList || [];},\n    filteredCourses(){return this.courses.filter(c=>{const k=this.appliedKeyword.toLowerCase();return (!k||(c.name+' '+c.code).toLowerCase().indexOf(k)!==-1)&&(this.filters.department==='전체'||c.department===this.filters.department)&&(this.filters.year==='전체'||c.year===this.filters.year)&&(this.filters.type==='전체'||c.type===this.filters.type)&&(this.filters.professor==='전체'||c.professor===this.filters.professor)&&(this.filters.day==='전체'||c.time.indexOf(this.filters.day)!==-1)&&(this.filters.time==='전체'||(this.filters.time==='오전'?/09:|10:|11:|12:/.test(c.time):/13:|14:|15:|16:|17:/.test(c.time)));});},\n    wishedCourses(){return this.courses.filter(c=>this.wishIds.indexOf(c.code)!==-1);},\n    possiblePairs(){return this.pairRows.filter(p=>p.possible);},\n    shownPairs(){return this.onlyPossible?this.possiblePairs:this.pairRows;},\n    filteredMyPairs(){return this.myPairs.filter(p=>(this.ownedFilter==='전체'||p.ownedName.indexOf(this.ownedFilter)!==-1)&&(this.statusFilter==='전체'||p.status===this.statusFilter));},\n    countdownDisplay(){const m=Math.floor(this.countdownSeconds/60);const s=this.countdownSeconds%60;return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');}\n  },\n  beforeDestroy(){if(this.countdownTimer)clearInterval(this.countdownTimer);},\n  methods:{\n    searchCourses(){this.appliedKeyword=this.keyword.trim();}, openCourse(course){this.selectedCourse=course;this.page='detail';}, toggleWish(course){const i=this.wishIds.indexOf(course.code);if(i===-1)this.wishIds.push(course.code);else this.wishIds.splice(i,1);}, isMine(code){return this.ownedCourses.concat(this.uploadedCourses).some(c=>c.code===code);},\n    pairAllowed(wanted,owned){return wanted.code!==owned.code && wanted.time!==owned.time;}, pairKey(wanted,owned){return owned.code+'-'+wanted.code;}, isPairSelected(wanted,owned){return this.selectedPairs.some(p=>p.key===this.pairKey(wanted,owned));}, togglePair(wanted,owned){const key=this.pairKey(wanted,owned);const i=this.selectedPairs.findIndex(p=>p.key===key);if(i!==-1)this.selectedPairs.splice(i,1);else this.selectedPairs.push({key,ownedName:owned.name+' '+owned.section,wantedName:wanted.name+' '+wanted.section,ownedCode:owned.code,wantedCode:wanted.code,priority:this.wishedCourses.findIndex(c=>c.code===wanted.code)+1,status:'대기',rank:'1위 / 3명',opposite:'1명',note:'반대쪽에 사람이 오면 매칭',});},\n    moveWish(index,delta){const arr=this.wishedCourses;const target=index+delta;if(target<0||target>=arr.length)return;const a=arr[index].code,b=arr[target].code;this.wishIds.splice(this.wishIds.indexOf(a),1);this.wishIds.splice(this.wishIds.indexOf(b),0,a);},\n    startMatching(){if(!this.selectedPairs.length)return;this.myPairs=this.selectedPairs.map(p=>Object.assign({},p,{status:'대기',note:'반대쪽에 사람이 오면 매칭'}));this.myPairs[0].status='매칭 중';this.myPairs[0].note='최종 확정 대기 · 05:00';this.activePair=this.myPairs[0];this.sessionStep=1;this.page='session';}, openSession(pair){this.activePair=pair;this.sessionStep=pair.status==='교환 완료'?3:1;this.page='session';}, startCountdown(){if(this.countdownTimer)clearInterval(this.countdownTimer);this.countdownSeconds=300;this.countdownTimer=setInterval(()=>{if(this.sessionStep!==2){clearInterval(this.countdownTimer);this.countdownTimer=null;return;}if(this.countdownSeconds>0)this.countdownSeconds--;if(this.countdownSeconds<=0){clearInterval(this.countdownTimer);this.countdownTimer=null;this.cancelExpiredSession();}},1000);}, cancelExpiredSession(){this.sessionStep=0;if(this.activePair){this.activePair.status='대기';this.activePair.note='자동 취소 · 5분 내 확정되지 않음';}this.otherAccepted=false;}, rejectSession(){if(this.countdownTimer)clearInterval(this.countdownTimer);this.countdownTimer=null;this.sessionStep=0;if(this.activePair){this.activePair.status='대기';this.activePair.note='거절됨 · 다른 상대 대기 중';} }, completeExchange(){if(this.countdownTimer)clearInterval(this.countdownTimer);this.countdownTimer=null;this.sessionStep=3;this.completedAt=new Date().toLocaleString('ko-KR',{hour12:false});if(this.activePair){this.activePair.status='교환 완료';this.activePair.note='완료 · '+this.completedAt;this.history.unshift({date:this.completedAt,from:this.activePair.ownedName,to:this.activePair.wantedName});}\n      // 실제 백엔드 연동 시 이 위치에서 교환 트랜잭션을 확정하고 수강신청내역 API를 갱신합니다.\n      // await api.exchange.confirm({sessionId, acceptedByRequester: true, acceptedByHolder: true});\n      // await api.enrollments.refresh();\n      if (this.activePair) {\n        const wantedCourse = this.courses.find(c => c.code === this.activePair.wantedCode) || this.courses.find(c => c.name === this.activePair.wantedName.replace(/ \\d+$/, ''));\n        const ownedCourse = this.ownedCourses.find(c => c.code === this.activePair.ownedCode);\n        if (ownedCourse) this.ownedCourses = this.ownedCourses.filter(c => c.code !== ownedCourse.code);\n        if (wantedCourse) {\n          this.$emit('exchangeComplete', { ownedCode: this.activePair.ownedCode, ownedCourse, receivedCourse: wantedCourse });\n        }\n      }\n    }, statusClass(status){return status==='매칭 중'?'status-matching':status==='교환 완료'?'status-done':status==='잠김'?'status-locked':'status-waiting';},\n    uploadCourse(){if(this.courses.some(c=>c.code===this.upload.code)||this.uploadedCourses.some(c=>c.code===this.upload.code)){alert('이미 등록된 학수번호입니다.');return;}const c=Object.assign({type:'전공선택',capacity:40,wishers:0,holders:1,department:'컴퓨터공학과',year:'3학년'},this.upload,{section:String(this.upload.section)});this.uploadedCourses.push(c);this.ownedCourses.push(c);this.courses.push(c);this.upload={code:'',name:'',section:'01',professor:'',time:'',credits:3};this.showUpload=false;},removeUploaded(code){this.uploadedCourses=this.uploadedCourses.filter(c=>c.code!==code);this.ownedCourses=this.ownedCourses.filter(c=>c.code!==code);this.courses=this.courses.filter(c=>c.code!==code);}\n  }\n};\n</script>\n\n<style scoped>\n*{box-sizing:border-box}.exchange-app{font-family:Arial,'Apple SD Gothic Neo',sans-serif;color:#222831;background:#f3f5f8;min-height:100vh;font-size:14px}.demo-banner{height:28px;background:#20242b;color:#fff;text-align:center;padding:6px;font-size:12px}.exchange-header{height:78px;background:#fff;