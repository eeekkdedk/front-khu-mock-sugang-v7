{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/common/CourseHeader.vue?vue&type=style&index=0&id=5135786c&lang=css","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/common/CourseHeader.vue","mtime":1793115113344},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/css-loader/dist/cjs.js","mtime":1793113953976},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1793113951739},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/postcss-loader/src/index.js","mtime":1793113949945},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CourseHeader.vue"],"names":[],"mappings":";AAyGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CourseHeader.vue","sourceRoot":"src/components/common","sourcesContent":["<template>\n <header class='header-register' >\n    <div class=\"nav-hide\">\n      <i class=\"fa fa-chevron-left arrow\"></i>\n    </div>\n    <div @click=\"goHome\" class=\"khu-logo\">\n      <img style=\"pointer-events: none\" src=\"khu-logo.png\" />\n    </div>\n    <div class=\"timmer\">\n      <div class=\"time\">\n        <div class=\"timerRemain\">{{ min }}:{{ sec }}</div>\n        <button @click=\"extendTime\" class=\"extend-btn\" type=\"button\" style=\"cursor:pointer;\">\n          연장하기\n        </button>\n      </div>\n      <div class=\"btn-lang\" id=\"lang\" style=\"cursor:not-allowed;\">ENG</div>\n      <div style=\"cursor:pointer;\" @click=\"goHome\" class=\"home\" title=\"Home\">\n        <img style=\"pointer-events: none\" class=\"home-img\" src=\"home.png\" />\n      </div>\n      <div style=\"cursor:pointer;\" @click=\"goHome\" class=\"logout-btn\" title=\"Logout\">\n        <i class=\"fa fa-unlock-alt lock\"></i>\n      </div>\n    </div>\n  </header>\n</template>\n\n<script>\nimport api from '@/api'; // 백엔드 통신 모듈 추가\n\nexport default {\n  name: \"app-header\",\n  props: [\"leftTime\"],\n  data() {\n    return {\n      // --- [1. 기존 타이머 변수 유지] ---\n      totalSec: 60 * 10,\n      timer: null,\n\n      // --- [2. 백엔드 프로필 데이터 변수 추가] ---\n      studentInfo: {\n        nickname: '',\n        currentCredits: 0,\n        maxCredits: 19\n      }\n    };\n  },\n  async mounted() {\n    // --- [백엔드 API 연동: 내 프로필/학점 가져오기] ---\n    try {\n      const res = await api.get('/api/students/me'); //\n      this.studentInfo = res.data;\n    } catch (err) {\n      console.error('내 프로필 로드 실패:', err);\n    }\n  },\n  created() {\n    // --- [기존 타이머 동작 유지] ---\n    this.timer = setInterval(() => {\n      if (this.totalSec > 0) this.totalSec--;\n    }, 1000);\n    \n    window.addEventListener('click', this.resetInactivityTimer);\n    window.addEventListener('keydown', this.resetInactivityTimer);\n  },\n  beforeDestroy() {\n    if (this.timer) clearInterval(this.timer);\n    window.removeEventListener('click', this.resetInactivityTimer);\n    window.removeEventListener('keydown', this.resetInactivityTimer);\n  },\n  watch: {\n    totalSec() {\n      if (this.totalSec == 0) {\n        clearInterval(this.timer);\n        // [연동 팁] 타이머 종료 시 로컬 로그인 정보도 함께 삭제\n        localStorage.removeItem('selectedStudentId');\n        localStorage.removeItem('accessToken');\n        this.$emit(\"timeOver\");\n      }\n    },\n  },\n  computed: {\n    min() {\n      const minute = parseInt(this.totalSec / 60);\n      return minute < 10 ? \"0\" + minute.toString() : minute;\n    },\n    sec() {\n      const second = parseInt(this.totalSec % 60);\n      return second < 10 ? \"0\" + second.toString() : second;\n    },\n  },\n  methods: {\n    extendTime() {\n      this.resetInactivityTimer();\n    },\n    resetInactivityTimer() {\n      if (this.totalSec > 0) this.totalSec = 60 * 10;\n    },\n    goHome() {\n      this.$emit(\"home\");\n    },\n  },\n};\n</script>\n\n<style>\n.header-register {\n  min-width: 1260px;\n  width: calc(100vw - 120px);\n  background-color: white;\n  border: 1px solid rgb(236, 236, 236);\n  height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  z-index: 3;\n  font-size: 16px;\n}\n/* 사이드바 숨기기 */\n.header-register .nav-hide {\n  width: 17px;\n  background-color: #f4f4f4;\n  height: inherit;\n  font-weight: lighter;\n  border: 1px solid rgb(236, 236, 236);\n}\n.header-register .arrow {\n  color: rgb(128, 128, 128);\n  padding: 21px 0 0 2px;\n  height: 20px;\n  font-size: 12px;\n}\n/*  */\n.header-register .khu-logo {\n  padding-left: 12px;\n}\n/* 타이머 부분 */\n.timmer {\n  left: 0;\n  font-size: 16px;\n  margin-left: auto;\n  height: inherit;\n  display: flex;\n  justify-content: flex-start;\n  align-items: center;\n  text-align: center;\n}\n.timmer div {\n  font-size: 16px;\n  height: inherit;\n  line-height: 55px;\n}\n.timmer .time {\n  display: flex;\n}\n.timmer .time .timerRemain {\n  font-weight: 400;\n  color: #e04616;\n  text-align: center;\n}\n.timmer .time .timerRemain::before {\n  content: \"\\f017\";\n  font-family: \"fontawesome\";\n  color: rgb(128, 128, 128);\n  font-weight: lighter;\n  opacity: 0.5;\n  margin-right: 3px;\n}\n.timmer .time .extend-btn {\n  margin: 15px 0 0 8px;\n  border: 1px solid #ddd;\n  border-radius: 2px;\n  font-size: 12px;\n  width: 60px;\n  height: 30px;\n  line-height: 20px;\n  margin-right: 20px;\n}\n/*  */\n.timmer .btn-lang,\n.home,\n.logout-btn {\n  margin: 0 15px;\n  color: rgb(128, 128, 128);\n}\n.timmer .btn-lang {\n  width: 46px;\n  font-weight: 700;\n  position: relative;\n}\n.timmer .btn-lang::after {\n  content: \"\";\n  width: 1px;\n  height: 20px;\n  background-color: #ddd;\n  position: absolute;\n  margin-top: 10px;\n  right: -10px;\n  top: 8px;\n}\n/* 홈 이미지 */\n.timmer .home {\n  width: 38px;\n  color: black;\n  z-index: 1001;\n  position: relative;\n}\n.timmer .home-img {\n  margin: 14px 10px 0 0;\n  width: 27px;\n  height: 27px;\n  object-fit: contain;\n  filter: opacity(0.5) drop-shadow(0 0 0 rgb(236, 236, 236));\n}\n.timmer .home::after {\n  content: \"\";\n  width: 1px;\n  height: 20px;\n  background-color: #ddd;\n  position: absolute;\n  margin-top: 10px;\n  right: -10px;\n  top: 8px;\n}\n.timmer .logout-btn {\n  width: 32px;\n}\n.timmer .logout-btn .lock {\n  font-size: 17px;\n  color: #7e7e7e;\n}\n</style>"]}]}