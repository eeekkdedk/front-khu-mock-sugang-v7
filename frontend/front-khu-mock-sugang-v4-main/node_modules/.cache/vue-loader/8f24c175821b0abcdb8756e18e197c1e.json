thods: {\n    async fetchMyEnrollments() {\n      try {\n        const res = await api.get('/api/enrollments/me'); // GET /api/enrollments/me 호출[cite: 3, 4]\n        this.myEnrollments = res.data;\n      } catch (err) {\n        console.error('수강 내역 로드 실패:', err);\n      }\n    }\n  }\n}\n</script>\n\n<style>\n\n</style>"]}]}