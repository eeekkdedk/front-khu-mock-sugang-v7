{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/CoursePage.vue?vue&type=script&lang=js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/CoursePage.vue","mtime":1793111882510},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/thread-loader/dist/cjs.js","mtime":1793113946318},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CoursePage.vue"],"names":[],"mappings":";AAiBA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CoursePage.vue","sourceRoot":"src/components","sourcesContent":["<template>\n    <div class=\"container\">\n<!-- props 로 sidebar 에서 선택 바꿈 이벤트가 내려오면 탭 바꿔주기-->\n        <notice-menu \n         @home=\"$emit('home')\"\n         v-if=\"isNoticeMenu\"></notice-menu>\n        <wish-menu v-if=\"isWishMenu\"></wish-menu>\n        <list-menu v-bind:courseList=\"courseList\" v-if=\"isListMenu\"></list-menu>\n        <exchange-menu v-if=\"isExchangeMenu\" v-bind:courseList=\"courseList\" @exchangeComplete=\"applyExchange\"></exchange-menu>\n        <time-limit v-if=\"isRegisterMenu && timeLimit>0\" v-bind:timeLimit=\"timeLimit\"></time-limit>\n        <!-- timeLimit 보고 모달 띄우기 -->\n        <register-menu @reset=\"resetCourses\" @renewal=\"renewalCourse\" @home=\"$emit('home')\" v-bind:Courses=\"courseList\" v-if=\"isRegisterMenu && timeLimit<=0\"></register-menu>\n        <course-footer></course-footer>\n    </div>\n</template>\n\n<script>\nimport ListMenu from './menu/ListMenu.vue';\nimport NoticeMenu from './menu/NoticeMenu.vue';\nimport RegisterMenu from './menu/RegisterMenu.vue';\nimport WishMenu from './menu/WishMenu.vue';\nimport ExchangeMenu from './menu/ExchangeMenu.vue';\nimport TimeLimit from './common/TimeLimit.vue';\nimport CourseFooter from './common/CourseFooter.vue';\n\nexport default {\n    props : ['timeLimit','menu'],\n    data(){\n        return {\n            courseList : [],\n        }\n    },\n    components : {\n        'list-menu' : ListMenu,\n        'notice-menu' : NoticeMenu,\n        'register-menu' : RegisterMenu,\n        'wish-menu' : WishMenu,\n        'exchange-menu' : ExchangeMenu,\n        'time-limit' : TimeLimit,\n        CourseFooter \n    },\n    computed: {\n        isNoticeMenu(){\n            if(this.menu=='noticeMenu') return true;\n            return false ; \n        },\n        isWishMenu(){\n            if(this.menu=='wishMenu') return true;\n            return false;\n        },\n        isListMenu(){\n            if(this.menu=='listMenu') return true;\n            return false; \n        },\n        isRegisterMenu(){\n            if(this.menu=='registerMenu') return true;\n            return false; \n        },\n        isExchangeMenu(){\n            return this.menu === 'exchangeMenu';\n        }\n    },\n    methods : {\n        renewalCourse(courses){\n            this.courseList=courses;\n        },\n        resetCourses(){\n            this.courseList=[];\n        },\n        applyExchange(exchange){\n            // 시연용: 준 강의는 수강신청내역에서 제거하고 받은 강의를 추가합니다.\n            // 실제 API 연결 시 교환 트랜잭션 완료 후 서버의 수강신청내역을 다시 조회하세요.\n            if (!exchange) return;\n            const ownedCode = exchange.ownedCode;\n            const receivedCourse = exchange.receivedCourse || exchange;\n            const ownedIndex = this.courseList.findIndex(item => item && item.code && item.code === ownedCode);\n            if (ownedIndex !== -1) {\n                this.courseList.splice(ownedIndex, 1);\n            } else if (this.courseList.length && this.courseList.every(item => typeof item === 'number')) {\n                // 기존 데모 수강신청은 숫자 ID만 저장하므로, 코드 매핑이 없는 경우 한 과목을 제거해 교환을 시연합니다.\n                this.courseList.pop();\n            }\n            if (receivedCourse && receivedCourse.code && !this.courseList.some(item => item && item.code === receivedCourse.code)) {\n                this.courseList.push(receivedCourse);\n            }\n        }\n    }\n}\n</script>\n\n<style>\n\n</style>"]}]}