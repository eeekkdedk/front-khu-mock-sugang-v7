l\"> \n      <div class=\"top\">\n        <a class=\"modal-notice\"\n          ><span style=\"font-weight: 400; font-size: 18px\">알림(notice)</span\n          ></a\n        >\n        <button @click=\"close\" class=\"modal-close\"></button>\n      </div>\n      <div class=\"middle\">\n        <a\n          ><span style=\"color: rgb(226, 0, 0)\"\n            ><i style=\"color:rgb(235, 34, 34); margin-right:3px;\" class=\"fas fa-exclamation-triangle\"></i></span\n          ><span style=\"font-size: 13px\">  {{ modalMessage }}</span></a\n        >\n      </div>\n      <div class=\"bottom\">\n        <button @click=\"accept\" class=\"gomain-btn\">확인</button><button @click=\"close\" v-if=\"courseDelete\" class=\"cancel-btn\" style=\"margin-left : 10px;\">취소</button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  props :['modalMessage',\"courseDelete\"],\n  methods: {\n    accept(){\n      this.$emit('accept')\n    },\n    close(){\n      this.$emit('close')\n    }\n  }\n};\n</script>\n\n<style>\n.modal-window {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 1001;\n  background-color: rgba(0, 0, 0, 0.7);\n}\n.modal {\n  z-index: 3;\n  color: black;\n  position: absolute;\n  left: 50%;\n  top: 40%;\n  transform: translate(-50%);\n  width: 320px;\n  height: 162px;\n  background-color: white;\n  opacity: 1;\n  border: 1px solid #ddd;\n}\n.modal button{\n  cursor: pointer;\n  border:none;\n}\n.modal .top {\n  height: 50px;\n  background-color: #f8fcf2;\n  line-height: 45px;\n  padding-left: 10px;\n  position: relative;\n  border-bottom: 1px solid #ddd;\n}\n.modal .top::after {\n  content: \"\";\n  background-color: rgb(105, 105, 105);\n  width: 1px;\n  height: 20px;\n  position: absolute;\n  top: 14px;\n  right: 20px;\n  transform: rotate(45deg);\n}\n.modal .top::before {\n  content: \"\";\n  background-color: rgb(105, 105, 105);\n  width: 1px;\n  height: 20px;\n  position: absolute;\n  top: 14px;\n  right: 20px;\n  transform: rotate(-45deg);\n  pointer-events: none;\n}\n.modal .modal-close {\n  position: absolute;\n  height: 35px;\n  width: 35px;\n  padding: 0;\n  top: 5px;\n  right: 5px;\n  background-color: transparent;\n}\n.modal .middle {\n  text-align: center;\n  height: 58px;\n  line-height: 50px;\n  border-bottom: 1px solid #ddd;\n}\n.modal .bottom {\n  height: 54px;\n  text-align: center;\n  line-height: 40px;\n}\n.modal .bottom .gomain-btn {\n  width: 56px;\n  height: 28px;\n  background-color: #253a73;\n  color: white;\n  border-radius: 2px;\n}\n.modal .bottom .gomain-btn:hover {\n  background-color: #1e2f5d;\n}\n/* 취소버튼 있는 삭제모달 */\n.cancel-btn {\n  width: 60px;\n  height: 34px;\n  border: 1px solid gray !important;\n  border-radius: 3px;\n  background-color: white;\n}\n@media screen and (max-width: 1380px) {\n  .modal-window {\n  width: 1380px;\n  height: 100%;\n  z-index: 1001;\n  background-color: rgba(0, 0, 0, 0.7);\n}\n}\n\n</style>"]}]}