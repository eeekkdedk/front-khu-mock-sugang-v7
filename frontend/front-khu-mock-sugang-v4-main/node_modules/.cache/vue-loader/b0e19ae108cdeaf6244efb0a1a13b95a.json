{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/shared/DefaultContent.vue?vue&type=script&lang=js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/shared/DefaultContent.vue","mtime":1793111883331},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/thread-loader/dist/cjs.js","mtime":1793113946318},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DefaultContent.vue"],"names":[],"mappings":";AAuEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"DefaultContent.vue","sourceRoot":"src/components/shared","sourcesContent":["<template>\n  <div class=\"wish-content\">\n    <div class=\"itb-wrapper\">\n      <div class=\"itb wish-itms\">\n        <div class=\"itm\">\n          <a class=\"emt\"></a>\n          <a class=\"itm-apply\">수강신청</a>\n          <a class=\"itm-clf\">구분</a>\n          <a class=\"itm-snum\">학수번호-분반</a>\n          <a class=\"itm-cname\">강좌명</a>\n          <a class=\"itm-grd\">대상학년</a>\n          <a class=\"itm-znum\">정원</a>\n          <a class=\"itm-zanum\">잔여인원</a>\n          <a class=\"itm-stime\">신청가능시간</a>\n          <a class=\"itm-gname\">교수명</a>\n          <a class=\"itm-hakzum\">학점</a>\n          <a class=\"itm-time\">강의시간/강의실</a>\n          <a class=\"itm-isgub\">이수구분</a>\n          <a style=\"flex:1;\"></a>\n        </div>\n        <div\n          class=\"itm\"\n          v-for=\"content in contents\"\n          v-bind:class=\"{\n            'spare-itm': content.num >= 8 && !content.registered,\n            'selected-itm': content.registered,\n          }\"\n          v-bind:key=\"content.num\"\n        >\n          <a class=\"itm-num\">{{ content.num }}</a>\n          <a class=\"itm-apply\">\n            <button\n              v-if=\"!content.registered\"\n              @click=\"() => courseApply(content.num)\"\n              class=\"apply-btn\"\n            >\n              신청\n            </button>\n            <span v-else style=\"color: red\">완료</span>\n          </a>\n          <a class=\"itm-clf\">{{ content.division }}</a>\n          <a class=\"itm-snum\">ADD123-01</a>\n          <a style=\"text-align:left;\" class=\"itm-cname\">{{ content.name }}</a>\n          <a class=\"itm-grd\">0</a>\n          <a class=\"itm-znum\">30</a>\n          <a class=\"itm-zanum\">10</a>\n          <a class=\"itm-stime\"></a>\n          <a class=\"itm-gname\">교수{{ content.num }}</a>\n          <a class=\"itm-hakzum\">3</a>\n          <a class=\"itm-time\">월 10:30-13:00 (강의실)</a>\n          <a class=\"itm-isgub\">04</a>\n          <a style=\"flex:1;\"></a>\n        </div>\n      </div>\n    </div>\n    <div class=\"itm-notice\">\n      <a\n        ><i\n          style=\"margin: 0 5px 0 15px; color: #39abd4; font-size: 20px\"\n          class=\"fas fa-exclamation-circle\"\n        >\n        </i\n        >희망과목 정원 및 잔여인원은 조회하는 시점 기준 인원으로 실시간\n        변동되므로, <em>'새로고침'</em> 또는 <em>'수강신청'</em> 재클릭시 조회\n        인원은 달라질 수 있습니다.</a\n      >\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: [\"isSearch\", \"courseFull\", \"savedCourses\",\"refresh\"],\n  data() {\n    return {\n      loading: true,\n      contents: [],\n      courseNum: \"\",\n      rigisterPause: false,\n    };\n  },\n  created() {\n    setTimeout(() => {\n      if (this.savedCourses !== null) {\n        this.contents = this.savedCourses;\n        return;\n      }\n      this.makeContents();\n    }, 1500);\n  },\n  methods: {\n    range: (l) => Array.apply(null, { length: l }).map((_, index) => index + 1),\n    makeContents() {\n      const arr = this.range(10);\n      this.contents = arr.map((num) => {\n        const obj = {};\n        obj.num = num;\n        obj.division = num <= 7 ? \"희망과목\" : \"예비과목\";\n        obj.name = num !== 10 ? \"신청연습\" : \"인원 초과 연습\";\n        obj.registered = false;\n        return obj;\n      });\n    },\n    courseApply(num) {\n      if (this.rigisterPause) return;\n      this.rigisterPause = true;\n      new Promise((resolve) => {\n        setTimeout(() => {\n          this.$emit(\"apply\", num);\n          // 수강신청 내역이 다 찼거나 인원초과 연습 \n          if (this.courseFull || num === 10) {\n            this.rigisterPause = false;\n            return;\n          }\n          resolve();\n        }, 1500);\n      }).then(() => {\n        this.doneContents(num);\n        this.$emit(\"save\", this.contents);\n        this.rigisterPause = false;\n      });\n    },\n    doneContents(num) {\n      this.contents.filter((el, index) => {\n        if (index + 1 === num) {\n          el.registered = true;\n        }\n        return el;\n      });\n    },\n        \n  },\n   watch: {\n      refresh(){\n        this.$emit('refresh','end') \n        this.contents=[];\n        setTimeout(() => {\n          this.makeContents();\n      }, 500);\n      }\n   }\n  };\n</script>\n\n<style>\n \n \n</style>"]}]}