{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/eslint-loader/index.js??ref--14-0!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js","mtime":1793183228698},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/babel.config.js","mtime":1793111879595},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/eslint-loader/index.js","mtime":1793113952474}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["axios","api","create","baseURL","interceptors","request","use","config","studentId","localStorage","getItem","token","headers","error","Promise","reject","response","status","console","warn","data","message","alert"],"sources":["/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js"],"sourcesContent":["import axios from 'axios';\n\nconst api = axios.create({\n  baseURL: '', // vue.config.js 프록시 설정 사용\n});\n\n// [요청 인터셉터] \n// 로그인 시 백엔드가 원하는 'studentNo' 형식을 보장하고, 인증 헤더를 자동으로 주입합니다.\napi.interceptors.request.use((config) => {\n  // 1. 학번 정보 추출 (localStorage에서 studentId 또는 studentNo 모두 대응)\n  const studentId = localStorage.getItem('selectedStudentId') || \n                    localStorage.getItem('studentId') || \n                    localStorage.getItem('studentNo');\n                    \n  const token = localStorage.getItem('accessToken');\n\n  // 2. 백엔드 통신을 위한 필수 헤더 주입\n  if (studentId) {\n    // 백엔드에서 요구하는 헤더 이름 (X-Student-Id)\n    config.headers['X-Student-Id'] = studentId;\n  }\n\n  if (token) {\n    // 인증 토큰 주입\n    config.headers['Authorization'] = `Bearer ${token}`;\n  }\n\n  return config;\n}, (error) => {\n  return Promise.reject(error);\n});\n\n// [응답 인터셉터]\napi.interceptors.response.use(\n  (response) => response,\n  (error) => {\n    // 401(Unauthorized) 또는 403(Forbidden) 발생 시 대응\n    if (error.response && (error.response.status === 401 || error.response.status === 403)) {\n      console.warn(`[API ${error.response.status}] 인증 실패 - 다시 로그인해주세요.`);\n      // 로그아웃 처리 로직이 필요하다면 여기에 추가 (예: localStorage.clear())\n      return Promise.reject(error);\n    }\n\n    // 백엔드에서 보낸 에러 메시지 팝업 출력\n    if (error.response && error.response.data && error.response.data.message) {\n      alert(error.response.data.message);\n    }\n    \n    return Promise.reject(error);\n  }\n);\n\nexport default api;"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AAEzB,MAAMC,GAAG,GAAGD,KAAK,CAACE,MAAM,CAAC;EACvBC,OAAO,EAAE,EAAE,CAAE;AACf,CAAC,CAAC;;AAEF;AACA;AACAF,GAAG,CAACG,YAAY,CAACC,OAAO,CAACC,GAAG,CAAEC,MAAM,IAAK;EACvC;EACA,MAAMC,SAAS,GAAGC,YAAY,CAACC,OAAO,CAAC,mBAAmB,CAAC,IACzCD,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC,IACjCD,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;EAEnD,MAAMC,KAAK,GAAGF,YAAY,CAACC,OAAO,CAAC,aAAa,CAAC;;EAEjD;EACA,IAAIF,SAAS,EAAE;IACb;IACAD,MAAM,CAACK,OAAO,CAAC,cAAc,CAAC,GAAGJ,SAAS;EAC5C;EAEA,IAAIG,KAAK,EAAE;IACT;IACAJ,MAAM,CAACK,OAAO,CAAC,eAAe,CAAC,GAAG,UAAUD,KAAK,EAAE;EACrD;EAEA,OAAOJ,MAAM;AACf,CAAC,EAAGM,KAAK,IAAK;EACZ,OAAOC,OAAO,CAACC,MAAM,CAACF,KAAK,CAAC;AAC9B,CAAC,CAAC;;AAEF;AACAZ,GAAG,CAACG,YAAY,CAACY,QAAQ,CAACV,GAAG,CAC1BU,QAAQ,IAAKA,QAAQ,EACrBH,KAAK,IAAK;EACT;EACA,IAAIA,KAAK,CAACG,QAAQ,KAAKH,KAAK,CAACG,QAAQ,CAACC,MAAM,KAAK,GAAG,IAAIJ,KAAK,CAACG,QAAQ,CAACC,MAAM,KAAK,GAAG,CAAC,EAAE;IACtFC,OAAO,CAACC,IAAI,CAAC,QAAQN,KAAK,CAACG,QAAQ,CAACC,MAAM,uBAAuB,CAAC;IAClE;IACA,OAAOH,OAAO,CAAC