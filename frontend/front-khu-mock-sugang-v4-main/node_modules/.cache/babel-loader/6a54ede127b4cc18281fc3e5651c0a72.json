{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/eslint-loader/index.js??ref--14-0!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js","mtime":1793117882573},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/babel.config.js","mtime":1793111879595},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/eslint-loader/index.js","mtime":1793113952474}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["axios","api","create","baseURL","interceptors","request","use","config","studentId","localStorage","getItem","token","headers","response","error","status","_error$config","console","warn","url","Promise","reject","data","message","alert"],"sources":["/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/api/index.js"],"sourcesContent":["import axios from 'axios';\n\nconst api = axios.create({\n  baseURL: '', // vue.config.js 프록시 타도록 상대 경로 설정\n});\n\n// [요청 인터셉터] README 규칙에 따른 인증 헤더 주입\napi.interceptors.request.use((config) => {\n  const studentId = localStorage.getItem('selectedStudentId') || localStorage.getItem('studentId');\n  const token = localStorage.getItem('accessToken');\n\n  // 1. 학번 헤더 주입 (DEMO 모드 및 학생 구분용)\n  if (studentId) {\n    config.headers['X-Student-Id'] = studentId;\n  }\n  \n  // 2. Bearer 토큰 주입 (TOKEN 모드용)\n  if (token) {\n    config.headers['Authorization'] = `Bearer ${token}`;\n  }\n\n  return config;\n});\n\n// [응답 인터셉터]\napi.interceptors.response.use(\n  (response) => response,\n  (error) => {\n    // 401(Unauthorized) 또는 403(Forbidden) 인증 에러 시 팝업을 차단하고 콘솔 경고만 출력\n    if (error.response && (error.response.status === 401 || error.response.status === 403)) {\n      console.warn(`[API ${error.response.status}] 인증/권한 부족 (데모 데이터 유지):`, error.config?.url);\n      return Promise.reject(error);\n    }\n    \n    // 그 외 백엔드가 전달한 에러 메시지 팝업 처리\n    if (error.response && error.response.data) {\n      const { message } = error.response.data;\n      if (message) alert(message);\n    }\n    return Promise.reject(error);\n  }\n);\n\nexport default api;"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AAEzB,MAAMC,GAAG,GAAGD,KAAK,CAACE,MAAM,CAAC;EACvBC,OAAO,EAAE,EAAE,CAAE;AACf,CAAC,CAAC;;AAEF;AACAF,GAAG,CAACG,YAAY,CAACC,OAAO,CAACC,GAAG,CAAEC,MAAM,IAAK;EACvC,MAAMC,SAAS,GAAGC,YAAY,CAACC,OAAO,CAAC,mBAAmB,CAAC,IAAID,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;EAChG,MAAMC,KAAK,GAAGF,YAAY,CAACC,OAAO,CAAC,aAAa,CAAC;;EAEjD;EACA,IAAIF,SAAS,EAAE;IACbD,MAAM,CAACK,OAAO,CAAC,cAAc,CAAC,GAAGJ,SAAS;EAC5C;;EAEA;EACA,IAAIG,KAAK,EAAE;IACTJ,MAAM,CAACK,OAAO,CAAC,eAAe,CAAC,GAAG,UAAUD,KAAK,EAAE;EACrD;EAEA,OAAOJ,MAAM;AACf,CAAC,CAAC;;AAEF;AACAN,GAAG,CAACG,YAAY,CAACS,QAAQ,CAACP,GAAG,CAC1BO,QAAQ,IAAKA,QAAQ,EACrBC,KAAK,IAAK;EACT;EACA,IAAIA,KAAK,CAACD,QAAQ,KAAKC,KAAK,CAACD,QAAQ,CAACE,MAAM,KAAK,GAAG,IAAID,KAAK,CAACD,QAAQ,CAACE,MAAM,KAAK,GAAG,CAAC,EAAE;IAAA,IAAAC,aAAA;IACtFC,OAAO,CAACC,IAAI,CAAC,QAAQJ,KAAK,CAACD,QAAQ,CAACE,MAAM,yBAAyB,GAAAC,aAAA,GAAEF,KAAK,CAACP,MAAM,cAAAS,aAAA,uBAAZA,aAAA,CAAcG,GAAG,CAAC;IACvF,OAAOC,OAAO,CAACC,MAAM,CAACP,KAAK,CAAC;EAC9B;;EAEA;EACA,IAAIA,KAAK,CAACD,QAAQ,IAAIC,KAAK,CAACD,QAAQ,CAACS,IAAI,EAAE;IACzC,MAAM;MAAEC;IAAQ,CAAC,GAAGT,KAAK,CAACD,QAAQ,CAACS,IAAI;IACvC,IAAIC,OAAO,EAAEC,KAAK,CAACD,OAAO,CAAC;EAC7B;EACA,OAAOH,OAAO,CAACC,MAAM,CAACP,KAAK,CAAC;AAC9B,CACF,CAAC;AAED,eAAeb,GAAG","ignore