 error.response.data) {\n      const { code, message } = error.response.data;\n      switch (code) {\n        case 'MISSING_STUDENT_ID':\n          alert('로그인이 필요한 서비스입니다.');\n          break;\n        case 'STUDENT_NOT_FOUND':\n          alert('존재하지 않는 학생 정보입니다.');\n          break;\n        case 'COURSE_NOT_FOUND':\n          alert('강의 정보를 찾을 수 없습니다.');\n          break;\n        default:\n          alert(message || '요청 처리 중 오류가 발생했습니다.');\n      }\n    }\n    return Promise.reject(error);\n  }\n);\n\nexport default api;"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;;AAEzB;AACA,MAAMC,GAAG,GAAGD,KAAK,CAACE,MAAM,CAAC;EACvBC,OAAO,EAAE;AACX,CAAC,CAAC;;AAEF;AACAF,GAAG,CAACG,YAAY,CAACC,OAAO,CAACC,GAAG,CAAEC,MAAM,IAAK;EACvC,MAAMC,SAAS,GAAGC,YAAY,CAACC,OAAO,CAAC,mBAAmB,CAAC;EAC3D,IAAIF,SAAS,EAAE;IACbD,MAAM,CAACI,OAAO,CAAC,cAAc,CAAC,GAAGH,SAAS;EAC5C;EACA,OAAOD,MAAM;AACf,CAAC,CAAC;;AAEF;AACAN,GAAG,CAACG,YAAY,CAACQ,QAAQ,CAACN,GAAG,CAC1BM,QAAQ,IAAKA,QAAQ,EACrBC,KAAK,IAAK;EACT,IAAIA,KAAK,CAACD,QAAQ,IAAIC,KAAK,CAACD,QAAQ,CAACE,IAAI,EAAE;IACzC,MAAM;MAAEC,IAAI;MAAEC;IAAQ,CAAC,GAAGH,KAAK,CAACD,QAAQ,CAACE,IAAI;IAC7C,QAAQC,IAAI;MACV,KAAK,oBAAoB;QACvBE,KAAK,CAAC,kBAAkB,CAAC;QACzB;MACF,KAAK,mBAAmB;QACtBA,KAAK,CAAC,mBAAmB,CAAC;QAC1B;MACF,KAAK,kBAAkB;QACrBA,KAAK,CAAC,mBAAmB,CAAC;QAC1B;MACF;QACEA,KAAK,CAACD,OAAO,IAAI,qBAAqB,CAAC;IAC3C;EACF;EACA,OAAOE,OAAO,CAACC,MAAM,CAACN,KAAK,CAAC;AAC9B,CACF,CAAC;AAED,eAAeZ,GAAG","ignoreList":[]}]}