ent-wrapper\">\n       <course-list v-bind:courseList=\"courseList\" v-bind:listMenu=\"true\"></course-list>\n   </div>\n</template>\n\n<script>\nimport CourseList from '../shared/CourseList.vue';\nimport api from '@/api'; // 1. 백엔드 통신 모듈 불러오기[cite: 3]\n\nexport default {\n  name: 'ListMenu',\n  props: ['courseList'],\n  components: { \n    CourseList \n  },\n  data() {\n    return {\n      myEnrollments: [] // 백엔드에서 받아온 내 수강 신청 내역 데이터를 담을 배열[cite: 3]\n    };\n  },\n  async mounted() {\n    // 2. 컴포넌트 마운트 시 백엔드 API로부터 내 수강 신청 내역 로드\n    this.fetchMyEnrollments();\n  },\n  methods: {\n    async fetchMyEnrollments() {\n      try {\n        const res = await api.get('/api/enrollments/me'); // GET /api/enrollments/me 호출[cite: 3, 4]\n        this.myEnrollments = res.data;\n      } catch (err) {\n        console.error('수강 내역 로드 실패:', err);\n      }\n    }\n  }\n}\n</script>\n\n<style>\n\n</style>"],"mappings":"AAOA,OAAAA,UAAA;AACA,OAAAC,GAAA;;AAEA;EACAC,IAAA;EACAC,KAAA;EACAC,UAAA;IACAJ;EACA;EACAK,KAAA;IACA;MACAC,aAAA;IACA;EACA;EACA,MAAAC,QAAA;IACA;IACA,KAAAC,kBAAA;EACA;EACAC,OAAA;IACA,MAAAD,mBAAA;MACA;QACA,MAAAE,GAAA,SAAAT,GAAA,CAAAU,GAAA;QACA,KAAAL,aAAA,GAAAI,GAAA,CAAAL,IAAA;MACA,SAAAO,GAAA;QACAC,OAAA,CAAAC,KAAA,iBAAAF,GAAA;MACA;IACA;EACA;AACA","ignoreList":[]}]}