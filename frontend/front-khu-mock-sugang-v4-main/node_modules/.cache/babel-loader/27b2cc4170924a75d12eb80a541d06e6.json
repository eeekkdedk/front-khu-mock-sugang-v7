{"remainingRequest":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js??ref--1-0!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js??vue-loader-options!/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/HomePage.vue?vue&type=script&lang=js","dependencies":[{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/src/components/HomePage.vue","mtime":1793183723097},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/babel.config.js","mtime":1793111879595},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/babel-loader/lib/index.js","mtime":1793113956357},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/cache-loader/dist/cjs.js","mtime":1793113954696},{"path":"/workspaces/front-khu-mock-sugang-v7/frontend/front-khu-mock-sugang-v4-main/node_modules/vue-loader/lib/index.js","mtime":1793113947877}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["api","name","data","fakeId","fakePwd","methods","startTest","studentNo","String","trim","password","alert","loginPayload","console","log","res","post","accessToken","localStorage","setItem","$emit","Error","err","error","msg","response","_err$response$data","message","status","request"],"sources":["src/components/HomePage.vue"],"sourcesContent":["<template>\n  <div class=\"container\">\n    <div class=\"contents\">\n      <form name=\"form\" id=\"form\" method=\"post\" @submit.prevent=\"startTest\">\n        <div class=\"wrap-login\" :style=\"{ 'background': 'url(bg-login.jpg) no-repeat center 0' }\">\n          <div>\n            <div class=\"login-box\">\n              <div class=\"wrap-lang\">\n                <input type=\"radio\" id=\"radio1\" name=\"lang\" value=\"ko\" checked=\"\"><label for=\"radio1\">Korean</label>\n              </div>\n              <select :style=\"{ 'background-image': 'url(bg-select.png) no-repeat center 0' }\" id=\"schedule_cd\" name=\"schedule_cd\" disabled>\n                <option>학부 수강신청</option>\n              </select>\n              <input v-model=\"fakeId\" :style=\"{ 'background': 'url(icon-id.png) no-repeat 10px center' }\" type=\"text\" class=\"input-id\" id=\"id\" name=\"id\" placeholder=\"학번 ( Student ID )\">\n              <input v-model=\"fakePwd\" :style=\"{ 'background': 'url(icon-pw.png) no-repeat 11px center' }\" type=\"password\" class=\"input-pw\" id=\"pwd\" name=\"pwd\" placeholder=\"비밀번호 ( Password )\">\n              <button @click.prevent=\"startTest\" style=\"cursor:pointer;\" type=\"button\" class=\"btn-login\" id=\"btn_login\">모의 수강신청 시작</button>\n              <button style=\"cursor:not-allowed;\" type=\"button\" class=\"btn-login-sub\">최초 사용자 비밀번호 등록</button>\n\n              <div class=\"text-btn\">\n                <span style=\"cursor:not-allowed;\">ID찾기 </span>\n                <span style=\"cursor:not-allowed;\">비밀번호 찾기 </span>\n              </div>\n              <div class=\"manual\">\n                <p style=\"cursor:not-allowed;\">\n                  <i :style=\"{ 'background-image': 'url(icon-pc.png)' }\" class=\"manual-pc\"></i>\n                  <span class=\"manual-text\">PC용 매뉴얼 </span>\n                </p>\n                <p style=\"cursor:not-allowed;\">\n                  <i :style=\"{ 'background-image': 'url(icon-mobile.png)' }\" class=\"manual-mobile\"></i>\n                  <span class=\"manual-text\">모바일용 매뉴얼 </span>\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </form>\n\n      <div class=\"login-contents\">\n        <div>\n          <h1>수강신청 일정<small>Course Registration Schedule</small></h1>\n          <div class=\"wrap-schedule\">\n            <div>\n              <h2>학부 수강신청<small>Undergraduate</small></h2>\n              <div class=\"schedule\">\n                <p>학부 수강 안내 <br> Course Registration <span style=\"cursor:not-allowed;\" :style=\"{ 'background': 'url(btn-more-blue.png) no-repeat center center' }\" class=\"btn-more\"></span></p>\n                <div :style=\"{ 'background': 'url(icon-clock.png) no-repeat left center' }\" class=\"time\">\n                  <span>2021/02/16 05:32:04</span>\n                </div>\n              </div>\n            </div>\n            <div>\n              <h2>희망과목 수강신청<small>WishList</small></h2>\n              <div class=\"schedule\">\n                <p>희망과목 수강 안내 <br> WishList Course Registration <span style=\"cursor:not-allowed;\" :style=\"{ 'background': 'url(btn-more-blue.png) no-repeat center center' }\" class=\"btn-more\"></span></p>\n                <div :style=\"{ 'background': 'url(icon-clock.png) no-repeat left center' }\" class=\"time\">\n                  <span>2021/02/16 05:32:04</span>\n                </div>\n              </div>\n            </div>\n            <div>\n              <h2>계절학기 수강신청<small>Summer/Winter</small></h2>\n              <div class=\"schedule\">\n                <p>계절학기 수강 안내 <br> Summer/Winter Course Registration <span style=\"cursor:not-allowed;\" :style=\"{ 'background': 'url(btn-more-blue.png) no-repeat center center' }\" class=\"btn-more\"></span></p>\n                <div :style=\"{ 'background': 'url(icon-clock.png) no-repeat left center' }\" class=\"time\">\n                  <span>2021/02/16 05:32:04</span>\n                </div>\n              </div>\n            </div>\n            <div>\n              <h2>대학원 수강신청<small>Graduate school</small></h2>\n              <div class=\"schedule\">\n                <p>대학원 수강 안내<br> Graduate Course Registration <span style=\"cursor:not-allowed;\" :style=\"{ 'background': 'url(btn-more-blue.png) no-repeat center center' }\" class=\"btn-more\"></span></p>\n                <div :style=\"{ 'background': 'url(icon-clock.png) no-repeat left center' }\" class=\"time\">\n                  <span>2021/02/16 05:32:04</span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <h1>공지사항<small>Notice</small></h1>\n          <div class=\"wrap-notice\">\n            <div>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\"><em>소융튜브</em> 에서 자체 제작한 <em>모의수강신청 사이트</em>로<br>폰트/아이콘/레이아웃 등이 살짝 다를 수 있습니다</p>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\"><em>학부 수강신청</em>기능만 제공하므로 이외 링크는 접속이 불가능할 수 있습니다</p>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\">사이트 소스코드는 <a href=\"https://github.com/Ywoosang/KHU-Sugang\" target=\"_blank\" rel=\"noopener noreferrer\"> Ywoosang/KHU-Sugang</a>에서 확인하실 수 있습니다 <br>개발 및 기타사항등 별도 문의 필요시 깃허브에 등록된 <em>개인 메일주소</em>로 부탁드립니다.</p>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\">오류 및 개선 문의는 <a href=\"https://github.com/Ywoosang/KHU-Sugang\" target=\"_blank\" rel=\"noopener noreferrer\"> Ywoosang/KHU-Sugang/issues </a> 에 <em>이슈</em> 로 등록합니다</p>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\"><em>2022년</em> 이후 제작자 <em>군대</em> 문제로 유지보수가 어려울 수 있습니다</p>\n              <p :style=\"{ 'background': 'url(bullet-blue.png) no-repeat 0 7px' }\"><em>크롬</em> 브라우저에 최적화 되어있습니다</p>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer\">\n        <div>\n          서울캠퍼스 02447 서울특별시 동대문구 경희대로 26 l 국제캠퍼스 17104 경기도 용인시 기흥구 덕영대로 1732 l 광릉캠퍼스 12001 경기도 남양주시 진접읍 광릉수목원로 195<br>\n          COPYRIGHT © KYUNG HEE UNIVERSITY. ALL RIGHT RESERVED.\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport api from '@/api';\n\nexport default {\n  name: 'HomePage',\n  data() {\n    return {\n      fakeId: '',\n      fakePwd: ''\n    };\n  },\n  methods: {\nasync startTest() {\n  // 1. 입력 값 가져오기 (공백 제거 및 문자열 변환)\n  const studentNo = String(this.fakeId).trim();\n  const password = String(this.fakePwd).trim(); // 사용자가 입력한 비밀번호 그대로 가져옴\n\n  // 2. 유효성 검사 (둘 다 입력되어야 함)\n  if (!studentNo || !password) {\n    alert('학번과 비밀번호를 모두 입력해 주세요.');\n    return;\n  }\n\n  // 3. [핵심] 백엔드 스펙에 맞춘 정석 페이로드\n  // 백엔드 README 명세에 따라 'studentNo'와 'password'를 정확히 전달합니다.\n  const loginPayload = {\n    studentNo: studentNo, \n    password: password\n  };\n\n  console.log('로그인 시도 데이터:', loginPayload);\n\n  try {\n    // 4. API 호출 (api 모듈 사용)\n    // 백엔드 엔드포인트가 /api/auth/login 인지 확인 필요\n    const res = await api.post('/api/auth/login', loginPayload);\n\n    // 5. 성공 시 처리\n    if (res.data && res.data.accessToken) {\n      console.log('로그인 성공! 토큰 수신 완료');\n      \n      // 토큰과 학번을 저장하여 로그인 상태 유지\n      localStorage.setItem('accessToken', res.data.accessToken);\n      localStorage.setItem('selectedStudentId', studentNo);\n      \n      // 성공 시 부모 컴포넌트로 이벤트 전송\n      this.$emit('startTest'); \n    } else {\n      throw new Error('서버 응답에 토큰이 없습니다.');\n    }\n\n  } catch (err) {\n    // 6. 실패 시 상세 이유 보고\n    console.error('로그인 실패 상세:', err);\n    \n    let msg = '로그인에 실패했습니다.';\n    if (err.response) {\n      // 백엔드에서 보내준 에러 메시지 (예: \"비밀번호가 틀렸습니다\")\n      msg = err.response.data?.message || `서버 에러: ${err.response.status}`;\n    } else if (err.request) {\n      // 서버에 요청은 보냈으나 응답을 못 받은 경우 (서버 꺼짐 등)\n      msg = '서버와 연결할 수 없습니다. 백엔드 서버가 실행 중인지 확인하세요.';\n    }\n    \n    alert(msg);\n  }\n}\n\n  }\n};\n</script>\n\n<style>\nhtml, body, * {\n    margin: 0;\n    padding: 0;\n    font-size: 13px;\n    color: #333;\n    line-height: 1.4;\n    box-sizing: border-box;\n    outline: 0 none;\n}\nh1 {\n    display: inline-block;\n    width: 100%;\n    padding-left: 2px;\n    font-size: 18px;\n    font-weight: 700;\n    color: #0d0d0d;\n}\nlink {\n    display: none;\n}\n*, *:after, *:before {\n    box-sizing: border-box;\n}\nem {\n    font-style: normal;\n    font-weight: bold;\n    font-size: inherit;\n    color: #fe842f;\n}\n\n.main {\n    margin-left: 120px;\n    height: 100%;\n    transition: all .4s;\n}\n.main>.wrap-loader {\n    position: fixed;\n}\n.wrap-loader {\n    position: absolute;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    z-index: 2;\n    text-align: center;\n    background: rgba(73,74,77,0.4);\n    transition: all 250ms linear;\n}\n.wrap-loader .loading-helper {\n    display: inline-block;\n    height: 100%;\n    vertical-align: middle;\n    margin-top: 50px;\n    margin-left: 50px;\n}\nspan, a {\n    display: inline-block;\n    font-size: inherit;\n    font-weight: inherit;\n    color: inherit;\n}\n.wrap-loader .loader {\n    position: relative;\n    display: inline-block;\n    text-indent: -9999999em;\n    border-radius: 100%;\n    width: 80px;\n    height: 80px;\n    margin-top: 5px;\n    border-top: 2px solid transparent;\n    border-right: 2px solid #253a73;\n    border-bottom: 2px solid transparent;\n    border-left: 2px solid #253a73;\n    -webkit-animation: load 1.0s infinite linear;\n    animation: load 1.0s infinite linear;\n}\n.wrap-loader .loading-text {\n    position: relative;\n    left: -65px;\n    top: -33px;\n    display: inline-block;\n    margin: 0 auto;\n    font-weight: bold;\n    font-size: 12px;\n    color: #253a73;\n    text-align: center;\n    text-transform: uppercase;\n    opacity: 0;\n    animation: loading-text 1.5s linear 0s infinite normal;\n}\n.to-top {\n    display: none;\n    position: fixed;\n    z-index: 1;\n    right: 20px;\n    bottom: 20px;\n    width: 32px;\n    height: 32px;\n    border-radius: 16px;\n    /* background:   url(./img/icon-top.png) no-repeat 50% 50%; */\n    cursor: pointer;\n}\n/* 헤더부분  */\n.main .header-login {\n    position:relative;\n    min-width: 1260px;\n    width: calc(100vw - 120px);\n    height: 94px;\n    padding: 0 30px;\n    background-color: #113769;\n    transition: all .2s;\n}\n.main .header-login .control {\n    position: absolute;\n    top: 0;\n    left: 0px;\n    width: 17px;\n    height: 94px;\n    margin: 0;\n    background: #253a73;\n    transition: all .4s;\n}\n.main .header-login .control::before {\n    content: \"\";\n    position: absolute;\n    top: 44px;\n    width: 6px;\n    height: 6px;\n    border: solid #fff;\n    border-width: 1px 1px 0 0;\n    background: transparent;\n    transition: all .4s;\n    display: flex;\n    flex-direction: column;\n}\n.main .header-login>div {\n    display: flex;\n    align-items: center;\n    position: relative;\n    height: 100%;\n    margin: 0 auto;\n}\n.main .header-login .control.is-opened:before {\n    left: 7px;\n    transform: rotate(\n-135deg\n);\n}\n\n/* 메인 부분 시작 */\n.container {\n    min-width: 1260px;\n    width: calc(100vw - 120px);\n    height: calc(100% - 60px);\n    overflow: auto;\n    transition: all .4s;\n}\n.container .contents {\n    overflow: hidden;\n    min-height: calc(100% - 35px);\n    padding-bottom: 0;\n}\n\n/* 로그인창 */\n.wrap-login {\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n    height: 535px;\n    /* background: url(\"./img/bg-login.jpg\") no-repeat center 0; */\n    box-sizing: border-box;\n}\n.wrap-login>div {\n    position: relative;\n    width: 1140px;\n    margin: 0 auto;\n}\n.wrap-login>div .login-box {\n    position: relative;\n    float: right;\n    width: 330px;\n    margin-top: 20px;\n    padding: 25px 30px 30px;\n    background: #fff;\n    box-sizing: border-box;\n}\n.wrap-login>div .login-box .wrap-lang {\n    margin-bottom: 18px;\n    text-transform: uppercase;\n}\ninput[type=\"radio\"], input[type=\"checkbox\"] {\n    margin-left: 0;\n    width: 18px;\n    height: 18px;\n    background: transparent;\n    vertical-align: text-top;\n    display: none;\n}\ninput[type=\"radio\"]+label, input[type=\"checkbox\"]+label {\n    display: inline-block;\n    position: relative;\n    height: 18px;\n    margin: 2px 0;\n    padding: 0 10px 0 25px;\n    transition: all .2s;\n}\ninput[type=\"radio\"]+label:before, input[type=\"checkbox\"]+label:before {\n    content: \"\";\n    border-color: #18a7b8;\n    border-radius: 10px;\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 18px;\n    height: 18px;\n    background: #fff;\n    border: 1px solid #ccc;\n    transition: all .2s;\n}\ninput[type=\"radio\"]:checked+label:after, input[type=\"checkbox\"]:checked+label:after {\n    content: \"\";\n    position: absolute;\n    top: 4px;\n    left: 4px;\n    width: 10px;\n    height: 10px;\n    border-radius: 1rem;\n    background: #18a7b8;\n    transition: all .2s;\n}\ninput[type=\"text\"], input[type=\"password\"] {\n    width: 100%;\n    font-family: \"Segoe UI\",\"맑은 고딕\",\"Malgun Gothic\",\"애플 SD 산돌고딕 Neo\",\"Apple SD Gothic Neo\",sans-serif;\n    font-weight: normal;\n    font-size: 13px;\n    letter-spacing: -.5px;\n    border: 1px solid #b9b9b9;\n    border-radius: 0;\n    appearance: none;\n    border-color: #ccc;\n    padding: 0 5px;\n}\n\n.wrap-login>div .login-box select {\n    height: 40px;\n    margin-bottom: 15px;\n    padding-left: 10px;\n    background-color: #f2f7fc;\n    background-position: right 15px top 50%;\n}\nselect {\n    width: 100%;\n    height: 34px;\n    font-family: \"Segoe UI\",\"맑은 고딕\",\"Malgun Gothic\",\"애플 SD 산돌고딕 Neo\",\"Apple SD Gothic Neo\",sans-serif;\n    font-weight: normal;\n    font-size: 13px;\n    line-height: 34px;\n    letter-spacing: -.5px;\n    border: 1px solid #b9b9b9;\n    border-radius: 0;\n    appearance: none;\n    box-sizing: border-box;\n    border-color: #ccc;\n    padding: 0 26px 2px 5px;\n    /* background-image: url(./img/bg-select.png); */\n    background-repeat: no-repeat;\n    background-position: right 8px top 50%;\n    line-height: 28px;\n}\nselect option {\n    padding-left: 5px;\n}\n/* .wrap-login>div .login-box input.input-id {\n    background: url(./img/icon-id.png) no-repeat 10px center;\n} */\n/* .wrap-login>div .login-box input.input-pw {\n    background: url(./img/icon-pw.png) no-repeat 11px center;\n} */\n.wrap-login>div .login-box button.btn-login {\n    width: 100%;\n    height: 50px;\n    margin-top: 10px;\n    margin-bottom: 10px;\n    background-color: #113769;\n    border-radius: 6px;\n    border: 0;\n    font-size: 18px;\n    font-weight: bold;\n    color: #fff;\n    text-align: center;\n}\n.wrap-login>div .login-box button.btn-login-sub {\n    width: 100%;\n    height: 40px;\n    background-color: #a6a39d;\n    border-radius: 6px;\n    border: 0;\n    font-size: 14px;\n    color: #fff;\n    text-align: center;\n}\n.wrap-login>div .login-box .text-btn {\n    display: -webkit-flex;\n    display: -ms-flexbox;\n    display: -webkit-box;\n    display: flex;\n    margin: 15px 0;\n}\n.wrap-login>div .login-box .text-btn span:first-child{\n    border:none;\n} \n.wrap-login>div .login-box .text-btn span {\n    -webkit-flex: 1 1 0;\n    -ms-flex: 1 1 0;\n    flex: 1 1 0;\n    max-width: 100%;\n    min-width: 0;\n    width: auto;\n    text-align: center;\n    cursor: pointer;\n    border-left: 1px solid #e6e6e6;\n}\n.wrap-login>div .login-box .manual {\n    display: flex;\n}\n.wrap-login>div .login-box .manual>p:first-child {\n    margin-left: 0;\n}\n.wrap-login>div .login-box .manual>p {\n    flex: 1 1 0;\n    max-width: 100%;\n    min-width: 0;\n    width: auto;\n    height: 90px;\n    background: #f3f3f3;\n    font-size: 15px;\n    font-weight: bold;\n    color: #113769;\n    text-align: center;\n    cursor: pointer;\n    margin-left: 1px;\n}\n.wrap-login>div .login-box .manual>p:hover {\n    background: #e6e6e6;\n}\n\n/* 인풋박스 */\n.wrap-login>div .login-box input {\n    float: left;\n    height: 40px;\n    line-height: 40px;\n    margin-bottom: 10px;\n    padding-left: 36px;\n}\n/* 매뉴얼 아이콘 */\n/* .wrap-login>div .login-bo