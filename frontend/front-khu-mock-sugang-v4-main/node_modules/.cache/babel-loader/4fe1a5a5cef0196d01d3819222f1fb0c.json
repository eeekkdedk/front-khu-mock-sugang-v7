1. 기본 헤더 설정\n  config.headers['Content-Type'] = 'application/json';\n  \n  // 2. CSRF 우회를 위한 시도 (일부 서버는 특정 헤더가 있으면 CSRF 체크를 건너뜁니다)\n  config.headers['X-Requested-With'] = 'XMLHttpRequest';\n  config.headers['X-CSRF-TOKEN'] = ''; // 빈 값을 보내어 형식을 맞춤\n  \n  // 3. 기존 인증 정보\n  const token = localStorage.getItem('accessToken');\n  if (token) {\n    config.headers['Authorization'] = `Bearer ${token}`;\n  }\n\n  return config;\n});\n\n\n// [응답 인터셉터]\napi.interceptors.response.use(\n  (response) => response,\n  (error) => {\n    // 401(Unauthorized) 또는 403(Forbidden) 발생 시 대응\n    if (error.response && (error.response.status === 401 || error.response.status === 403)) {\n      console.warn(`[API ${error.response.status}] 인증 실패 - 다시 로그인해주세요.`);\n      // 로그아웃 처리 로직이 필요하다면 여기에 추가 (예: localStorage.clear())\n      return Promise.reject(error);\n    }\n\n    // 백엔드에서 보낸 에러 메시지 팝업 출력\n    if (error.response && error.response.data && error.response.data.message) {\n      alert(error.response.data.message);\n    }\n    \n    return Promise.reject(error);\n  }\n);\n\nexport default api;"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AAEzB,MAAMC,GAAG,GAAGD,KAAK,CAACE,MAAM,CAAC;EACvBC,OAAO,EAAE,EAAE,CAAE;AACf,CAAC,CAAC;;AAEF;AACA;AACA;AACAF,GAAG,CAACG,YAAY,CAACC,OAAO,CAACC,GAAG,CAAEC,MAAM,IAAK;EACvC;EACAA,MAAM,CAACC,OAAO,CAAC,cAAc,CAAC,GAAG,kBAAkB;;EAEnD;EACAD,MAAM,CAACC,OAAO,CAAC,kBAAkB,CAAC,GAAG,gBAAgB;EACrDD,MAAM,CAACC,OAAO,CAAC,cAAc,CAAC,GAAG,EAAE,CAAC,CAAC;;EAErC;EACA,MAAMC,KAAK,GAAGC,YAAY,CAACC,OAAO,CAAC,aAAa,CAAC;EACjD,IAAIF,KAAK,EAAE;IACTF,MAAM,CAACC,OAAO,CAAC,eAAe,CAAC,GAAG,UAAUC,KAAK,EAAE;EACrD;EAEA,OAAOF,MAAM;AACf,CAAC,CAAC;;AAGF;AACAN,GAAG,CAACG,YAAY,CAACQ,QAAQ,CAACN,GAAG,CAC1BM,QAAQ,IAAKA,QAAQ,EACrBC,KAAK,IAAK;EACT;EACA,IAAIA,KAAK,CAACD,QAAQ,KAAKC,KAAK,CAACD,QAAQ,CAACE,MAAM,KAAK,GAAG,IAAID,KAAK,CAACD,QAAQ,CAACE,MAAM,KAAK,GAAG,CAAC,EAAE;IACtFC,OAAO,CAACC,IAAI,CAAC,QAAQH,KAAK,CAACD,QAAQ,CAACE,MAAM,uBAAuB,CAAC;IAClE;IACA,OAAOG,OAAO,CAACC,MAAM,CAACL,KAAK,CAAC;EAC9B;;EAEA;EACA,IAAIA,KAA